# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# Deployment guard rails (Day 28)
APP_PASSWORD=              # leave empty to disable the password screen (local use)
MAX_RUNS_PER_DAY=10        # research runs allowed per UTC day
VALIDATE_URLS_LIVE=false   # true: also check that cited links respond (adds a few seconds)

# Optional switches (the app sets these from its sidebar):
# VERIFY_BY_SEARCH=true      # search for a second independent source for weak claims
# SEARCH_CACHE=true          # 24h disk cache for searches
# EVIDENCE_GATE=strict       # confirmed needs 2 domains whose sentences state the claim
# SEMANTIC_JUDGE=true        # LLM may rescue paraphrases the rules cannot decide
# DISPUTE_ON_CONFLICT=true   # a contradicting source sentence makes the claim DISPUTED
